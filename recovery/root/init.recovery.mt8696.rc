import /tee-supplicant.rc

on init
    install_keyring

    mkdir /config
    setprop sys.usb.ffs.aio_compat 1
    setprop sys.usb.controller "11201000.usb"
    setprop sys.usb.configfs 1

on fs
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/platform/bootdevice
    symlink /dev/block/platform/soc/11230000.mmc /dev/block/platform/soc/bootdevice

    wait /dev/block/by-name/userdata
    wait /dev/block/by-name/super

    exec_start fix-symlinks

on boot
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x201c

    mkdir /config/usb_gadget/g1/functions/ffs.mtp
    mkdir /dev/usb-ffs/mtp 0770 shell shell
    mount functionfs mtp /dev/usb-ffs/mtp uid=2000,gid=2000,rmode=0770,fmode=0660

on property:sys.usb.config=adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x201c

on property:sys.usb.config=mtp,adb && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x201c
    write /config/usb_gadget/g1/configs/b.1/strings/0x409/configuration "mtp_adb"
    symlink /config/usb_gadget/g1/functions/ffs.mtp /config/usb_gadget/g1/configs/b.1/f1
    symlink /config/usb_gadget/g1/functions/ffs.adb /config/usb_gadget/g1/configs/b.1/f2
    write /config/usb_gadget/g1/UDC ${sys.usb.controller}
    setprop sys.usb.state ${sys.usb.config}

on property:sys.usb.config=none && property:sys.usb.configfs=1
    rm /config/usb_gadget/g1/configs/b.1/f2

on property:sys.usb.config=sideload && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x201c

on property:sys.usb.config=fastboot && property:sys.usb.ffs.ready=1 && property:sys.usb.configfs=1
    write /config/usb_gadget/g1/idVendor 0x1949
    write /config/usb_gadget/g1/idProduct 0x201c

on property:twrp.preloader=rw
    write /sys/block/mmcblk0boot0/force_ro 0

on property:twrp.preloader=ro
    write /sys/block/mmcblk0boot0/force_ro 1

service fix-symlinks /system/bin/sh /system/bin/fix-symlinks.sh
    seclabel u:r:recovery:s0
    disabled
    oneshot
