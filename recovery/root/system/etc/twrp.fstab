# mount point   fstype  device                                  device2     flags

/system_root    ext4    /dev/block/mapper/system                             flags=display="System";logical;backup=1
/vendor         ext4    /dev/block/mapper/vendor                             flags=display="Vendor";logical;backup=1;fsflags=ro
/product        ext4    /dev/block/mapper/product                            flags=display="Product";logical;backup=1;fsflags=ro

/data           ext4    /dev/block/by-name/userdata                          flags=fileencryption=aes-256-xts:aes-256-cts:v2;keydirectory=/metadata/vold/metadata_encryption;wipeingui
/cache          ext4    /dev/block/by-name/cache                             flags=display="Cache";wipeingui
/metadata       ext4    /dev/block/by-name/metadata                          flags=display="Metadata";backup=1;wipeingui

/boot           emmc    /dev/block/by-name/boot                              flags=display="Boot";backup=1;flashimg=1
/recovery       emmc    /dev/block/by-name/recovery                          flags=display="Recovery";backup=1;flashimg=1
/dtbo           emmc    /dev/block/by-name/dtbo                              flags=display="DTBO";backup=1;flashimg=1
/vbmeta         emmc    /dev/block/by-name/vbmeta                            flags=display="VBMeta";backup=1;flashimg=1
/lk             emmc    /dev/block/by-name/lk_real                                flags=display="Bootloader";backup=1;flashimg=1
/logo           emmc    /dev/block/by-name/logo                              flags=display="Logo";backup=1;flashimg=1
/misc           emmc    /dev/block/by-name/misc                              flags=display="Misc"
/tee1           emmc    /dev/block/by-name/tee1_real                              flags=display="TEE1";backup=1
/tee2           emmc    /dev/block/by-name/tee2_real                              flags=display="TEE2";backup=1

/usb-otg        auto    /dev/block/sda1                         /dev/block/sda   flags=display="USB OTG";storage;removable;wipeingui
